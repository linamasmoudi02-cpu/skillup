# Copier ce fichier en ".env.local" puis remplacer la valeur par votre propre clé.
# Ne jamais mettre .env.local sur Git (il est déjà ignoré par .gitignore).

# Clé API (Google AI Studio pour Gemini, ou console.groq.com pour Groq)
VITE_AI_API_KEY=votre_cle_ici

# Facultatif : "gemini" (par défaut) ou "groq"
# VITE_AI_PROVIDER=gemini

# Facultatif : nom du modèle si celui par défaut n'est plus disponible
# VITE_AI_MODEL=gemini-3.6-flash
